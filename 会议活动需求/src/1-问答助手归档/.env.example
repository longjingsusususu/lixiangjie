# 复制为 .env 后按需修改；本项目所有变量都有安全默认值，不配置也能跑

# SQLite 数据库路径（默认 <repo>/data/meeting.db）
MEETING_DB=

# JWT 签名密钥。上线前必须改成随机 32 字节以上字符串
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
MEETING_JWT_SECRET=meeting-demo-secret-change-me-32bytes

# LLM 汇总开关：off = 纯规则文案（一期默认，客户红线 f01）；on = 走 OpenAI 兼容接口
MEETING_LLM_PROVIDER=off
MEETING_LLM_BASE_URL=https://api.example.com/v1
MEETING_LLM_API_KEY=
MEETING_LLM_MODEL=gpt-4o-mini

# 服务监听
MEETING_HOST=127.0.0.1
MEETING_PORT=8010
